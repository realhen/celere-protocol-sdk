# RPC and wallet must belong to the same cluster as your chosen market.
RPC_URL=https://your-solana-rpc.example
# Absolute path to a Solana CLI keypair JSON. No private key belongs in this folder.
KEYPAIR_PATH=/absolute/path/to/your/keypair.json
# Token to receive. Select a live market yourself; no hard-coded trade target.
TOKEN_MINT=
# Atomic input units, not a decimal token amount. 10000000 lamports = 0.01 SOL.
AMOUNT_IN_ATOMS=10000000
SLIPPAGE_BPS=100
# Address of a supported DLMM pool containing INPUT_MINT and TOKEN_MINT.
POOL_ADDRESS=
# Defaults to WSOL. For a different quote token, fund its canonical ATA first.
INPUT_MINT=So11111111111111111111111111111111111111112

# Optional concurrent lanes. With either key set, NONCE_ACCOUNT is required.
# Each configured provider plus the default RPC submits the buy at once.
HELIUS_API_KEY=
ZERO_SLOT_API_KEY=
# Optional endpoint override for another region or a local simulator.
ZERO_SLOT_ENDPOINT=
# Existing nonce account, exclusively selected for this trade, authorized by KEYPAIR_PATH.
NONCE_ACCOUNT=
# Provider tip per transaction variant (lamports). RPC-only has no provider tip.
TIP_LAMPORTS=1000000
# Leave blank to average recent per-slot priority fee samples (micro-lamports/CU).
# The example also enforces each selected provider's minimum total priority fee.
CU_PRICE_MICROLAMPORTS=
