{
  "name": "celere-protocol-sdk",
  "version": "0.1.0-alpha.0",
  "description": "Strictly offline Solana swap instruction and unsigned transaction builders",
  "type": "module",
  "license": "MIT",
  "author": "realhen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realhen/celere-protocol-sdk.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./transactions": {
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js"
    },
    "./protocols/pump": {
      "types": "./dist/protocols/pump/bonding-curve.d.ts",
      "import": "./dist/protocols/pump/bonding-curve.js"
    },
    "./protocols/raydium-cpmm": {
      "types": "./dist/protocols/raydium/cpmm.d.ts",
      "import": "./dist/protocols/raydium/cpmm.js"
    },
    "./protocols/orca": {
      "types": "./dist/protocols/orca/whirlpool.d.ts",
      "import": "./dist/protocols/orca/whirlpool.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-orca-core.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "test:surfpool": "npm run build && node scripts/test-surfpool.mjs"
  },
  "dependencies": {
    "@orca-so/whirlpools-core": "1.0.3",
    "@solana/kit": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
